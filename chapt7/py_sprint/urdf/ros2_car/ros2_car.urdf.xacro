<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ros2_car">

  <!-- 基础部分：base_link -->
  <xacro:include filename="$(find py_sprint)/urdf/ros2_car/sensor/base.urdf.xacro"/>

  <!-- 传感器部分 -->
  <xacro:include filename="$(find py_sprint)/urdf/ros2_car/sensor/imu.urdf.xacro"/>
  <xacro:include filename="$(find py_sprint)/urdf/ros2_car/sensor/camera.urdf.xacro"/>
  <xacro:include filename="$(find py_sprint)/urdf/ros2_car/sensor/laser.urdf.xacro"/>


  <xacro:base_xacro length="0.12" radius="0.10" />
  <xacro:imu_xacro xyz="0.0 0.0 0.02" />
  <xacro:camera_xacro xyz="0.10 0.0 0.075" />
  <xacro:laser_xacro xyz="0.0 0.0 0.10" />
 
   <!-- 执行器组件 -->
  <xacro:include filename="$(find py_sprint)/urdf/ros2_car/actuator/wheel.urdf.xacro" />
  <xacro:include filename="$(find py_sprint)/urdf/ros2_car/actuator/caster.urdf.xacro" />
  ...
  <!-- 执行器主动轮 + 从动轮 -->
  <xacro:wheel_xacro  wheel_name="left"   xyz="0 0.10   -0.051" />
  <xacro:wheel_xacro  wheel_name="right"  xyz="0 -0.10  -0.051" />
  <xacro:caster_xacro caster_name="front" xyz="0.08 0   -0.075" />
  <xacro:caster_xacro caster_name="back"  xyz="-0.08 0  -0.075" />

</robot>
