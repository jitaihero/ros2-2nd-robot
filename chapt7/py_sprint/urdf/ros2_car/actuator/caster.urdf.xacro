<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:include filename="$(find py_sprint)/urdf/ros2_car/common_inertia.xacro" />
    <xacro:macro name="caster_xacro" params="caster_name xyz">

        <gazebo reference="${caster_name}_caster_link">
            <mu1 value="0.0" />
            <mu2 value="0.0" />
            <kp value="10000000000.0" />
            <kd value="1.0" />
        </gazebo>
    <!-- 轮子(万向轮)部分 -->
        <link name = "${caster_name}_caster_link">
            <!--部件的外观描述 -->
            <visual>
                <!-- 沿着自己几何中心的偏移和旋转量 -->
                <origin xyz="0.0 0.0 0.0" rpy="1.57079 0.0 0.0"/>
                <!-- 几何形状-->
                <geometry>
                    <sphere radius="0.016"/>
                </geometry>
                <!-- 材质颜色 --> 
                <material name="yellow">
                    <color rgba="1.0 1.0 0.0 0.8"/>
                </material>
            </visual>

            <collision>
                <!-- 沿着自己几何中心的偏移和旋转量 -->
                    <origin xyz="0.0 0.0 0.0" rpy="1.57079 0.0 0.0"/>
                    <!-- 几何形状-->
                    <geometry>
                        <sphere radius="0.016"/>
                    </geometry>
                    <!-- 材质颜色 --> 
                    <material name="yellow">
                        <color rgba="1.0 1.0 0.0 0.8"/>
                    </material>
            </collision>

            <xacro:sphere_inertia m="0.05" r="0.016" />
        </link>
        <joint name="${caster_name}_caster_joint" type="fixed">
            <parent link="base_link" />
            <child link="${caster_name}_caster_link" />
            <origin xyz="${xyz}" />
            <axis xyz = "0.0 1.0 0.0" />
        </joint>
    </xacro:macro>
</robot>